# Copy to .env, fill in, then:  set -a; source .env; set +a
# Token: https://resonance.meetiqm.com  -> side panel -> "Create token". Never commit this file.
RESONANCE_API_KEY=paste-your-token-here
# IQM_TOKENS_FILE=/path/to/tokens.json        # alternative to a raw token (common on HPC sites)
IQM_BASE_URL=https://resonance.meetiqm.com
IQM_QC_ALIAS=garnet                           # garnet | emerald | sirius ... (what your account can see)
# IQM_DEVICE_ID=                              # leave empty -> first IQM ID from `qdmi_demo.py list`
